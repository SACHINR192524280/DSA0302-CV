# Experiment 12
# Horizontal Line Detection

from google.colab import files
import cv2
import numpy as np
import matplotlib.pyplot as plt

# Upload image
uploaded = files.upload()

# Read uploaded image
image_path = list(uploaded.keys())[0]

# Read image
img = cv2.imread(image_path)

# Convert to grayscale
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

# Horizontal Line Detection Kernel
kernel = np.array([
    [-1, -1, -1],
    [ 2,  2,  2],
    [-1, -1, -1]
], dtype=np.float32)

# Apply filter
horizontal = cv2.filter2D(gray, -1, kernel)

# Threshold
_, detected = cv2.threshold(horizontal, 100, 255, cv2.THRESH_BINARY)

# Display images
plt.figure(figsize=(12,5))

plt.subplot(1,3,1)
plt.imshow(gray, cmap='gray')
plt.title("Original Image")
plt.axis('off')

plt.subplot(1,3,2)
plt.imshow(horizontal, cmap='gray')
plt.title("Horizontal Line Response")
plt.axis('off')

plt.subplot(1,3,3)
plt.imshow(detected, cmap='gray')
plt.title("Detected Horizontal Lines")
plt.axis('off')

plt.tight_layout()
plt.show()

# Histogram
plt.figure(figsize=(10,4))

plt.subplot(1,2,1)
plt.hist(gray.ravel(), bins=256, range=[0,256])
plt.title("Original Histogram")

plt.subplot(1,2,2)
plt.hist(horizontal.ravel(), bins=256, range=[0,256])
plt.title("Filtered Histogram")

plt.tight_layout()
plt.show()

print("Horizontal Line Detection Kernel:")
print(kernel)
